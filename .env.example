# Any OpenAI-compatible provider. Default: Groq (free tier) https://console.groq.com
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Gemini alternative:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# Indian-English neural voice (free credits at https://dashboard.sarvam.ai). Optional: without it the browser voice is used.
SARVAM_API_KEY=your_key_here
TTS_SPEAKER=priya
TTS_MODEL=bulbul:v3

# Optional: comma-separated models to try if the main one hits its quota
LLM_FALLBACK_MODELS=openai/gpt-oss-20b
